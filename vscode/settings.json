{
    "files.associations": {
        "**/dbt_project/**/*.yaml": "jinja-yaml",
        "**/dbt_project/**/*.yml": "jinja-yaml",
        "**/dbt_project/**/*.sql": "jinja-sql",
        "**/dbt_project/**/docs/**/*.md": "jinja-md",
        // optional: don't format models in `target/` dir
        "**/target/**": "",
        "justfile": "makefile"
    },
    "editor.formatOnSave": true,
    "editor.largeFileOptimizations": false,
    "editor.quickSuggestions": {
        "strings": true
    },
    "editor.wordWrap": "on",
    "diagramspreviewer.pythonCommand": "VS Code Python Interpreter",
    "diffEditor.ignoreTrimWhitespace": false,
    "git.autofetch": true,
    "git.confirmSync": false,
    "gitlens.autolinks": [],
    "gitlens.defaultDateLocale": "de-DE",
    "gitlens.defaultDateFormat": "YYYY-MM-DD, hh:mm:ss",
    "gitlens.defaultDateShortFormat": "YY-MM-DD",
    "gitlens.sortBranchesBy": "name:asc",
    "gitlens.views.branches.files.compact": false,
    "[jinja-sql]": {
        "editor.defaultFormatter": "dorzey.vscode-sqlfluff"
    },
    "[python]": {
        "editor.formatOnType": true
    },
    "redhat.telemetry.enabled": false,
    "sqlfluff.config": ".github/linters/.sqlfluff",
    "sqlfluff.dialect": "bigquery",
    "vsicons.dontShowNewVersionMessage": true,
    "workbench.iconTheme": "vscode-icons",
    "workbench.startupEditor": "none",
    "python.createEnvironment.trigger": "off",
    "python.defaultInterpreterPath": "",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "ruff.configuration": ".github/linters/.ruff.toml",
    "comments.openView": "never",
    "editor.fontFamily": "MesloLGL Nerd Font Mono",
}